generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   // Hashed password (if using custom auth)
  role      String   // "patient" or "physician"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Patient-specific fields
  dob                    String?
  sex                    String?  // "Male" or "Female"
  height                 Float?   // Height in cm or inches
  weight                 Float?   // Baseline weight in lbs or kg
  conditions             String[]
  allergies              String[]
  familyHistoryHeartDisease String?  // Family history of heart disease
  smokingHistory         String?  // Smoking history (e.g., "Never smoker", "Former smoker", "Current smoker")
  smokingDetails         String?  // Details about smoking history
  alcoholUse             String?  // Alcohol use information
  
  // Relationships
  measurements   Measurement[]
  medications    Medication[]
  goals          Goal?
  events         Event[]
  chats          Chat[]
  patientAnalysis PatientAnalysis?
  
  // Physician-Patient relationships
  // If this user is a patient, these are their physicians
  physicians     PhysicianPatient[] @relation("PatientPhysicians")
  // If this user is a physician, these are their patients
  patients       PhysicianPatient[] @relation("PhysicianPatients")
}

model PhysicianPatient {
  id          String   @id @default(cuid())
  physicianId String
  patientId   String
  createdAt   DateTime @default(now())
  
  physician   User     @relation("PhysicianPatients", fields: [physicianId], references: [id], onDelete: Cascade)
  patient     User     @relation("PatientPhysicians", fields: [patientId], references: [id], onDelete: Cascade)
  
  @@unique([physicianId, patientId]) // Prevent duplicate relationships
  @@index([physicianId])
  @@index([patientId])
}

model Medication {
  id        String   @id @default(cuid())
  userId    String
  name      String
  dosage    String
  frequency String
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Measurement {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime
  // Blood Pressure
  systolic        Float?
  diastolic       Float?
  bpRaw           Json?    // Array of {systolic: number, diastolic: number}
  // Glucose
  glucose         Float?
  glucoseRaw      Json?    // Array of numbers
  // Weight
  weight          Float?
  createdAt       DateTime @default(now())
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, date])
}

model Goal {
  id              String   @id @default(cuid())
  userId          String   @unique
  // Blood Pressure Goals - Range-based
  systolicMin     Float?   // Target range minimum (e.g., 110)
  systolicMax     Float?   // Target range maximum (e.g., 135)
  diastolicMin    Float?   // Target range minimum (e.g., 70)
  diastolicMax    Float?   // Target range maximum (e.g., 85)
  // Glucose Goal - Range-based
  glucoseMin      Float?   // Target range minimum (e.g., 70)
  glucoseMax      Float?   // Target range maximum (e.g., 180)
  // Weight - Baseline and alert thresholds (no goal weight)
  weightBaseline  Float?   // Baseline weight for tracking changes
  weightDailyAlertThreshold Float?  // Alert if daily gain > this (default: 2 lbs)
  weightWeeklyAlertThreshold Float?  // Alert if weekly gain > this (default: 5 lbs)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?  // Physician who set the goal
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Event {
  id                 String   @id @default(cuid())
  userId             String
  date               DateTime
  title              String
  description        String?
  lifestyleChanges   String[]
  medicationChanges  String[]
  source             String?  // "chat_conversation", "manual", "measurement", etc.
  createdAt          DateTime @default(now())
  
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, date])
}

model Chat {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String   // "user" or "assistant"
  content   String
  createdAt DateTime @default(now())
  
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  @@index([chatId])
}

model PatientAnalysis {
  id          String   @id @default(cuid())
  userId      String   @unique
  summary     String
  urgency     String   // "urgent", "monitor", "stable"
  urgencyScore Int
  reasons     String[] // Array of reason strings
  keyConcerns String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}